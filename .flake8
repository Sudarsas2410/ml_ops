[flake8]
max-line-length = 110
# E203: black formats slices like x[a + 1 :], which flake8 flags (known black/flake8 conflict)
extend-ignore = E203
exclude = .git,__pycache__,venv,.venv,mlruns,mlartifacts,notebooks
per-file-ignores =
    src/train.py:E402
    src/eda.py:E402
    scripts/mlflow_summary.py:E402
    scripts/build_notebooks.py:E501
